{
  "seed": 0,
  "default_inference_steps": 10,
  "checkpoint": "checkpoints/Movens-Zero-XL/model.safetensors",
  "normalization": "assets/normalization.json",
  "initial_pose": "assets/initial_pose.npy",
  "model": {
    "backbone": "Qwen/Qwen2.5-Omni-3B",
    "action_dim": 40,
    "action_horizon": 30,
    "action_exec_horizon": 20,
    "rtc_max_delay": 11,
    "state_dim": 40,
    "hidden_dim": 1920,
    "num_blocks": 7,
    "num_heads": 30,
    "qk_norm": "fp32_layer_norm",
    "view_feature_dim": 2048,
    "use_future_progress": true,
    "future_progress_dim": 5,
    "train_diffusion_steps": 1000,
    "noise_scheduler": "flow"
  },
  "motion": {
    "fps": 50,
    "past_frames": 0,
    "representation": "root40_v1",
    "contact_protocol": "isaac_leg_delta_v2"
  },
  "modalities": {
    "text": {},
    "music": {
      "decoder": "ffmpeg",
      "sampling_rate": 16000,
      "window_seconds": 0.6,
      "left_context_seconds": 0.0,
      "full_input": false,
      "align_start_hold": true
    },
    "speech": {
      "decoder": "ffmpeg",
      "sampling_rate": 16000,
      "window_seconds": 0.6,
      "left_context_seconds": 0.0,
      "full_input": true,
      "align_start_hold": true
    },
    "video": {
      "decoder": "ffmpeg",
      "sample_fps": 8.0,
      "size_pixels": 50176,
      "clip_aligned": true
    }
  },
  "cfg_scale": 1.5,
  "cfg_interval": [
    0.2,
    0.8
  ]
}
