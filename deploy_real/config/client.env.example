# Copy to PROJECT_ROOT/.deploy_real.env and set your inference server's LAN address.
PSI_HOST=127.0.0.1
PSI_PORT=8014
UNITREE_SDK_ROOT="$HOME/GR00T-WholeBodyControl/external_dependencies/unitree_sdk2_python"
SONIC_ROOT="$HOME/GR00T-WholeBodyControl/gear_sonic_deploy"
G1_NETWORK_INTERFACE=enP8p1s0
CYCLONEDDS_HOME=/usr/local
CYCLONEDDS_LIB=/usr/local/lib
# Conservative shared default; do not relax this to hide tracking/model errors.
MAX_FIRST_JOINT_JUMP_RAD=0.35
